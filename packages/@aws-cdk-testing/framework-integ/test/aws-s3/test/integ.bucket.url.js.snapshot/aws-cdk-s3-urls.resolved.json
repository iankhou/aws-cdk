  },
  "VirtualHostedObjectURLNonRegional": {
   "Value": "https://${MyBucketF68F3FF0.DomainName}/myfolder/myfile.txt"
  },
  "S3ObjectURL": {
   "Value": "s3://${MyBucketF68F3FF0}/myfolder/myfile.txt"
  }
 },
 "unresolved": []
}
