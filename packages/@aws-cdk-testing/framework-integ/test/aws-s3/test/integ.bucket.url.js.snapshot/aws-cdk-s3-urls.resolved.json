{
 "version": "1",
 "stackName": "aws-cdk-s3-urls",
 "resources": {
  "MyBucketF68F3FF0": {
   "Type": "AWS::S3::Bucket",
   "UpdateReplacePolicy": "Delete",
   "DeletionPolicy": "Delete"
  }
 },
 "outputs": {
  "BucketURL": {
   "Value": "${MyBucketF68F3FF0.WebsiteURL}"
  },
  "ObjectURL": {
