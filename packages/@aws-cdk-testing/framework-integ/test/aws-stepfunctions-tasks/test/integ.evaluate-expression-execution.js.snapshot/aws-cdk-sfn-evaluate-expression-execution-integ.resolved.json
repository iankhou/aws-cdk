    "DefinitionString": "{\"StartAt\":\"Sum\",\"States\":{\"Sum\":{\"Next\":\"Product\",\"Type\":\"Task\",\"ResultPath\":\"$.sum\",\"Resource\":\"${SumEvalFunctionF2909C56.Arn}\",\"Parameters\":{\"expression\":\"$.a + $.b\",\"expressionAttributeValues\":{\"$.a.$\":\"$.a\",\"$.b.$\":\"$.b\"}}},\"Product\":{\"Next\":\"Overlap\",\"Type\":\"Task\",\"ResultPath\":\"$.product\",\"Resource\":\"${ProductEvalFunction9FBC78E7.Arn}\",\"Parameters\":{\"expression\":\"$.a * $.b\",\"expressionAttributeValues\":{\"$.a.$\":\"$.a\",\"$.b.$\":\"$.b\"}}},\"Overlap\":{\"Next\":\"Greeting\",\"Type\":\"Task\",\"ResultPath\":\"$.overlap\",\"Resource\":\"${OverlapEvalFunctionA8230216.Arn}\",\"Parameters\":{\"expression\":\"$.a + $.ab\",\"expressionAttributeValues\":{\"$.a.$\":\"$.a\",\"$.ab.$\":\"$.ab\"}}},\"Greeting\":{\"Next\":\"Template\",\"Type\":\"Task\",\"ResultPath\":\"$.greeting\",\"Resource\":\"${GreetingEvalFunctionDB9E606D.Arn}\",\"Parameters\":{\"expression\":\"$.first + ' ' + $.last\",\"expressionAttributeValues\":{\"$.first.$\":\"$.first\",\"$.last.$\":\"$.last\"}}},\"Template\":{\"Next\":\"Max\",\"Type\":\"Task\",\"ResultPath\":\"$.template\",\"Resource\":\"${TemplateEvalFunctionB45F3DAC.Arn}\",\"Parameters\":{\"expression\":\"`${!$.first} ${!$.last}`\",\"expressionAttributeValues\":{\"$.first.$\":\"$.first\",\"$.last.$\":\"$.last\"}}},\"Max\":{\"Next\":\"Rounded\",\"Type\":\"Task\",\"ResultPath\":\"$.max\",\"Resource\":\"${MaxEvalFunctionDC2950B5.Arn}\",\"Parameters\":{\"expression\":\"Math.max($.a, $.b)\",\"expressionAttributeValues\":{\"$.a.$\":\"$.a\",\"$.b.$\":\"$.b\"}}},\"Rounded\":{\"Next\":\"DayObj\",\"Type\":\"Task\",\"ResultPath\":\"$.rounded\",\"Resource\":\"${RoundedEvalFunction989139E9.Arn}\",\"Parameters\":{\"expression\":\"($.a / $.b).toFixed(2)\",\"expressionAttributeValues\":{\"$.a.$\":\"$.a\",\"$.b.$\":\"$.b\"}}},\"DayObj\":{\"Next\":\"Dash\",\"Type\":\"Task\",\"ResultPath\":\"$.dayObj\",\"Resource\":\"${DayObjEvalFunction74507B24.Arn}\",\"Parameters\":{\"expression\":\"const t = $.runDate;\\n({ day: t })\",\"expressionAttributeValues\":{\"$.runDate.$\":\"$.runDate\"}}},\"Dash\":{\"Next\":\"Joined\",\"Type\":\"Task\",\"ResultPath\":\"$.dash\",\"Resource\":\"${DashEvalFunction55C6E9D5.Arn}\",\"Parameters\":{\"expression\":\"`${!$.first}-${!$.last}`\",\"expressionAttributeValues\":{\"$.first.$\":\"$.first\",\"$.last.$\":\"$.last\"}}},\"Joined\":{\"Next\":\"Parsed\",\"Type\":\"Task\",\"ResultPath\":\"$.joined\",\"Resource\":\"${JoinedEvalFunction8ECBBD6C.Arn}\",\"Parameters\":{\"expression\":\"($.items).join(',')\",\"expressionAttributeValues\":{\"$.items.$\":\"$.items\"}}},\"Parsed\":{\"Next\":\"Iso\",\"Type\":\"Task\",\"ResultPath\":\"$.parsed\",\"Resource\":\"${ParsedEvalFunction3B20BD65.Arn}\",\"Parameters\":{\"expression\":\"JSON.parse($.jsonStr)\",\"expressionAttributeValues\":{\"$.jsonStr.$\":\"$.jsonStr\"}}},\"Iso\":{\"Next\":\"Iife\",\"Type\":\"Task\",\"ResultPath\":\"$.iso\",\"Resource\":\"${IsoEvalFunction6212976A.Arn}\",\"Parameters\":{\"expression\":\"new Date($.epoch).toISOString()\",\"expressionAttributeValues\":{\"$.epoch.$\":\"$.epoch\"}}},\"Iife\":{\"Next\":\"Ternary\",\"Type\":\"Task\",\"ResultPath\":\"$.iife\",\"Resource\":\"${IifeEvalFunction02819D1B.Arn}\",\"Parameters\":{\"expression\":\"(function(){ return $.a + $.b; })()\",\"expressionAttributeValues\":{\"$.a.$\":\"$.a\",\"$.b.$\":\"$.b\"}}},\"Ternary\":{\"Next\":\"HelloGreeting\",\"Type\":\"Task\",\"ResultPath\":\"$.ternary\",\"Resource\":\"${TernaryEvalFunction80A0104E.Arn}\",\"Parameters\":{\"expression\":\"$.type == 'Forward' ? 'A' : 'B'\",\"expressionAttributeValues\":{\"$.type.$\":\"$.type\"}}},\"HelloGreeting\":{\"Next\":\"Replaced\",\"Type\":\"Task\",\"ResultPath\":\"$.helloGreeting\",\"Resource\":\"${HelloGreetingEvalFunction000639A5.Arn}\",\"Parameters\":{\"expression\":\"'Hello ' + $.first + ' ' + $.last\",\"expressionAttributeValues\":{\"$.first.$\":\"$.first\",\"$.last.$\":\"$.last\"}}},\"Replaced\":{\"End\":true,\"Type\":\"Task\",\"