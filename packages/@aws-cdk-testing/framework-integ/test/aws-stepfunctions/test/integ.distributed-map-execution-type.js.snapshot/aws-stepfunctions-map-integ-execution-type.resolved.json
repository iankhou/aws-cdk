{
 "version": "1",
 "stackName": "aws-stepfunctions-map-integ-execution-type",
 "resources": {
  "StateMachineRoleB840431D": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Statement": [
      {
       "Action": "sts:AssumeRole",
       "Condition": {
        "ArnLike": {
         "aws:SourceArn": "arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:*"
        },
        "StringEquals": {
         "aws:SourceAccount": "${AWS::AccountId}"
        }
       },
       "Effect": "Allow",
       "Principal": {
        "Service": "states.amazonaws.com"
       }
      }
     ],
     "Version": "2012-10-17"
    }
   }
  },
  "StateMachine2E01A3A5": {
   "Type": "AWS::StepFunctions::StateMachine",
   "Properties": {
    "DefinitionString": "{\"StartAt\":\"DistributedMap\",\"States\":{\"DistributedMap\":{\"Type\":\"Map\",\"End\":true,\"ItemProcessor\":{\"ProcessorConfig\":{\"Mode\":\"DISTRIBUTED\",\"ExecutionType\":\"EXPRESS\"},\"StartAt\":\"Pass\",\"States\":{\"Pass\":{\"Type\":\"Pass\",\"End\":true}}}}}}",
    "RoleArn": "${StateMachineRoleB840431D.Arn}"
   },
   "DependsOn": [
    "StateMachineRoleB840431D"
   ],
   "UpdateReplacePolicy": "Delete",
   "DeletionPolicy": "Delete"
  },
  "StateMachineDistributedMapPolicy57C9D8C2": {
   "Type": "AWS::IAM::Policy",
   "Properties": {
    "PolicyDocument": {
     "Statement": [
      {
       "Action": "states:StartExecution",
       "Effect": "Allow",
       "Resource": "${StateMachine2E01A3A5}"
      },
      {
       "Action": [
        "states:DescribeExecution",
        "states:StopExecution"
       ],
       "Effect": "Allow",
       "Resource": "arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:execution:${StateMachine2E01A3A5.Name}:*"
      },
      {
       "Action": "states:RedriveExecution",
       "Effect": "Allow",
       "Resource": "arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:execution:${StateMachine2E01A3A5.Name}/*:*"
      }
     ],
     "Version": "2012-10-17"
    },
    "PolicyName": "StateMachineDistributedMapPolicy57C9D8C2",
    "Roles": [
     "${StateMachineRoleB840431D}"
    ]
   }
  }
 },
 "unresolved": []
}
