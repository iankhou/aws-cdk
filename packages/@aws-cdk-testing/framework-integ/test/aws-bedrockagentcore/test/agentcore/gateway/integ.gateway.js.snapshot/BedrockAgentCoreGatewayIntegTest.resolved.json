  "RequestInterceptorBE1C44C8": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "Code": {
     "ZipFile": "\ndef handler(event, context):\n    \"\"\"\n    REQUEST interceptor - executes before gateway calls the target.\n    Validates and transforms the request before it reaches the target.\n    \"\"\"\n    import json\n    print(f\"Request Interceptor invoked with event: {json.dumps(event)}\")\n    \n    # Return the request unchanged (pass-through interceptor for testing)\n    return {\n        \"interceptorOutputVersion\": \"1.0\",\n        \"mcp\": {\n            \"transformedGatewayRequest\": event.get(\"mcp\", {}).get(\"gatewayRequest\", {})\n        }\n    }\n  "
    },
    "Description": "REQUEST interceptor for Gateway integration test",
    "FunctionName": "integ-test-gateway-request-interceptor",
    "Handler": "index.handler",
    "Role": "${RequestInterceptorServiceRoleD8815DF9.Arn}",
    "Runtime": "python3.12"
   },
   "DependsOn": [
    "RequestInterceptorServiceRoleD8815DF9"
   ]
  },
