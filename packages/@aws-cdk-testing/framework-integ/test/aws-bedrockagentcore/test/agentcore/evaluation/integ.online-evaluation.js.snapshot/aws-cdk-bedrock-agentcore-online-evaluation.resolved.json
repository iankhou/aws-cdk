{
 "version": "1",
 "stackName": "aws-cdk-bedrock-agentcore-online-evaluation",
 "resources": {
  "AgentLogGroupFDA72973": {
   "Type": "AWS::Logs::LogGroup",
   "Properties": {
    "LogGroupName": "/aws/bedrock-agentcore/integ-test-agent",
    "RetentionInDays": 1
   },
   "UpdateReplacePolicy": "Delete",
   "DeletionPolicy": "Delete"
  },
  "CustomEvaluator9FEA397A": {
   "Type": "AWS::BedrockAgentCore::Evaluator",
   "Properties": {
    "Description": "Custom evaluator for integration testing",
    "EvaluatorConfig": {
     "LlmAsAJudge": {
      "Instructions": "Evaluate whether the agent response is helpful, accurate, and well-structured. Context: {context}. Available tools: {available_tools}.",
      "ModelConfig": {
       "BedrockEvaluatorModelConfig": {
        "ModelId": "us.anthropic.claude-sonnet-4-6"
       }
      },
      "RatingScale": {
       "Categorical": [
        {
         "Definition": "The response fully addresses the user query with accurate information.",
         "Label": "Good"
        },
        {
         "Definition": "The response fails to address the query or contains inaccurate information.",
         "Label": "Bad"
        }
       ]
      }
     }
    },
    "EvaluatorName": "integ_test_custom_eval",
    "Level": "SESSION",
    "Tags": [
     {
      "Key": "Environment",
      "Value": "IntegTest"
     },
     {
      "Key": "Team",
      "Value": "CDKAbstractions"
     }
    ]
   }
  },
  "BasicEvaluationExecutionRoleFB7E4913": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Statement": [
      {
       "Action": "sts:AssumeRole",
       "Condition": {
        "StringEquals": {
         "aws:SourceAccount": "${AWS::AccountId}",
         "aws:ResourceAccount": "${AWS::AccountId}"
        },
        "ArnLike": {
         "aws:SourceArn": [
          "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:evaluator/*",
          "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:online-evaluation-config/*"
         ]
        }
       },
       "Effect": "Allow",
       "Principal": {
        "Service": "bedrock-agentcore.amazonaws.com"
       }
      }
     ],
     "Version": "2012-10-17"
    },
    "Description": "Execution role for Bedrock AgentCore Online Evaluation"
   }
  },
  "BasicEvaluationExecutionRoleDefaultPolicy6E0AF966": {
   "Type": "AWS::IAM::Policy",
   "Properties": {
    "PolicyDocument": {
     "Statement": [
      {
       "Action": "logs:DescribeLogGroups",
       "Effect": "Allow",
       "Resource": "*",
       "Sid": "CloudWatchLogDescribeStatement"
      },
      {
       "Action": [
        "logs:GetQueryResults",
        "logs:StartQuery"
       ],
       "Effect": "Allow",
       "Resource": [
        "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${AgentLogGroupFDA72973}:*",
        "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${AgentLogGroupFDA72973}",
        "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:aws/spans",
        "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:aws/spans:*"
       ],
       "Sid": "CloudWatchLogQueryStatement"
      },
      {
       "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
       ],
       "Effect": "Allow",
       "Resource": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/bedrock-agentcore/evaluations/*",
       "Sid": "CloudWatchLogWriteStatement"
      },
      {
       "Action": [
        "logs:DescribeIndexPolicies",
        "logs:PutIndexPolicy"
       ],
       "Effect": "Allow",
       "Resource": [
        "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:aws/spans",
        "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:aws/spans:*"
       ],
       "Sid": "CloudWatchIndexPolicyStatement"
      },
      {
       "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
       ],
       "Effect": "Allow",
       "Resource": [
        "arn:${AWS::Partition}:bedrock:*:${AWS::AccountId}:inference-profile/*",
        "arn:${AWS::Partition}:bedrock:*::foundation-model/*"
       ],
       "Sid": "BedrockInvokeStatement"
      }
     ],
     "Version": "2012-10-17"
    },
    "PolicyName": "BasicEvaluationExecutionRoleDefaultPolicy6E0AF966",
    "Roles": [
     "${BasicEvaluationExecutionRoleFB7E4913}"
    ]
   }
  },
  "BasicEvaluationB20A0A46": {
   "Type": "AWS::BedrockAgentCore::OnlineEvaluationConfig",
   "Properties": {
    "DataSourceConfig": {
     "CloudWatchLogs": {
      "LogGroupNames": [
       "${AgentLogGroupFDA72973}"
      ],
      "ServiceNames": [
       "integ-test-agent.default"
      ]
     }
    },
    "Description": "Integration test evaluation with built-in and custom evaluators",
    "EvaluationExecutionRoleArn": "${BasicEvaluationExecutionRoleFB7E4913.Arn}",
    "Evaluators": [
     {
      "EvaluatorId": "Builtin.Helpfulness"
     },
     {
      "EvaluatorId": "Builtin.Correctness"
     },
     {
      "EvaluatorId": "${CustomEvaluator9FEA397A.EvaluatorId}"
     }
    ],
    "ExecutionStatus": "ENABLED",
    "OnlineEvaluationConfigName": "integ_test_basic_eval",
    "Rule": {
     "SamplingConfig": {
      "SamplingPercentage": 10
     },
     "SessionConfig": {
      "SessionTimeoutMinutes": 15
     }
    },
    "Tags": [
     {
      "Key": "Environment",
      "Value": "IntegTest"
     },
     {
      "Key": "Project",
      "Value": "OnlineEval"
     }
    ]
   },
   "DependsOn": [
    "BasicEvaluationExecutionRoleDefaultPolicy6E0AF966",
    "BasicEvaluationExecutionRoleFB7E4913"
   ]
  }
 },
 "unresolved": []
}
